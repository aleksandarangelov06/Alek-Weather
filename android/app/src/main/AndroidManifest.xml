<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Weather notifications (rain, alerts, tomorrow); runtime-requested on 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app updater: hand a downloaded release APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets. Each kind is its own provider so it shows up in
             the launcher's picker on its own; they share AlekWidgetProvider and
             draw from WidgetData's cache. -->
        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".CompactWidget" android:exported="false" android:label="@string/widget_name_compact">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_compact" />
        </receiver>
        <receiver android:name=".NowWidget" android:exported="false" android:label="@string/widget_name_now3">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_now3" />
        </receiver>
        <receiver android:name=".HourlyWidget" android:exported="false" android:label="@string/widget_name_hourly">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_hourly" />
        </receiver>
        <receiver android:name=".DetailsWidget" android:exported="false" android:label="@string/widget_name_details">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_details" />
        </receiver>
        <receiver android:name=".ComboWidget" android:exported="false" android:label="@string/widget_name_combo">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_combo" />
        </receiver>

        <!-- Shares the downloaded update APK to the package installer over a
             content:// URI; a file:// hand-off is rejected on Android 7+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>
