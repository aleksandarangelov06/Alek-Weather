<?xml version="1.0" encoding="utf-8"?>
<!-- 4x3: right now, then the app's Details readings as eight tiles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky_clear_day"
    android:clipToOutline="true"
    android:padding="16dp">

    <include layout="@layout/widget_empty" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <include layout="@layout/widget_place" />

                    <TextView
                        android:id="@+id/updated"
                        style="@style/WidgetText"
                        android:paddingTop="2dp"
                        android:textSize="13sp"
                        android:text=" · 2:40 PM" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/temp"
                        style="@style/WidgetTemp"
                        android:textSize="42sp"
                        android:text="61°" />

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wx_sun" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/cond"
                    style="@style/WidgetText.Medium"
                    android:textSize="14sp"
                    android:text="Clear Sky" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText"
                    android:layout_marginTop="3dp"
                    android:textSize="13sp"
                    android:text="H 63°  L 44°" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="10dp" />

        <LinearLayout
            android:id="@+id/tiles_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/tiles_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-4dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
