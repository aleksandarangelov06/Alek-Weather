<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4: active NWS alert (hidden when there is none), right now, the next
     five hours, and the next three days with temperature bars. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky_storm"
    android:clipToOutline="true"
    android:padding="16dp">

    <include layout="@layout/widget_empty" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/alert_bright"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/alert_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_alert" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alert_title"
                    style="@style/WidgetText.Medium"
                    android:textSize="12.5sp"
                    android:text="Severe Thunderstorm Warning" />

                <TextView
                    android:id="@+id/alert_until"
                    style="@style/WidgetText"
                    android:layout_marginTop="2dp"
                    android:textSize="11.5sp"
                    android:text="Until 6:15 PM · Tap to read it" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp"
                style="@style/WidgetTemp"
                android:textSize="46sp"
                android:text="68°" />

            <ImageView
                android:id="@+id/icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/wx_storm" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <include layout="@layout/widget_place" />

                <TextView
                    android:id="@+id/cond"
                    style="@style/WidgetText.Medium"
                    android:layout_marginTop="2dp"
                    android:textSize="14sp"
                    android:text="Thunderstorm" />

                <TextView
                    android:id="@+id/hilo"
                    style="@style/WidgetText"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:text="Feels 71° · H 74° L 59°" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <FrameLayout
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="#29ffffff" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
