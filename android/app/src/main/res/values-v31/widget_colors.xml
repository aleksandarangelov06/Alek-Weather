<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: Material You takes its surfaces and text from the
         wallpaper. The launcher resolves these when it draws the widget, so a
         new wallpaper recolors it without waiting for the next refresh. The
         reading colors (rain, good, warn, bad) and the alert stay fixed: they
         carry meaning and shouldn't shift hue with the wallpaper. -->
    <color name="wl_surface">@android:color/system_neutral1_50</color>
    <color name="wl_tile">@android:color/system_accent2_100</color>
    <color name="wl_text">@android:color/system_neutral1_900</color>
    <color name="wl_sub">@android:color/system_neutral2_700</color>

    <color name="wd_surface">@android:color/system_neutral1_900</color>
    <color name="wd_tile">@android:color/system_neutral1_800</color>
    <color name="wd_text">@android:color/system_neutral1_100</color>
    <color name="wd_sub">@android:color/system_neutral2_200</color>
</resources>
