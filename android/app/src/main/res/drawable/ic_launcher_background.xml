<?xml version="1.0" encoding="utf-8"?>
<!-- Clear: the launcher icon has no plate, just the sun and cloud. The adaptive
     icon still needs a background layer, so this is a transparent one. The art
     in ic_launcher_foreground is centred and kept inside the 66dp safe zone,
     so no launcher mask (circle, squircle, teardrop) clips it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
