<?xml version="1.0" encoding="utf-8"?>
<!-- Half light, half dark: Material You comes in both. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/wl_surface" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/wd_surface" />
            <corners android:topRightRadius="12dp" android:bottomRightRadius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/cfg_swatch_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
