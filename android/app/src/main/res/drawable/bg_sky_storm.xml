<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Sky style: the app's sky gradient for this condition, held to its
     deeper stops so white text keeps its contrast. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#0a0c14" android:centerColor="#12172a" android:endColor="#1a1f38" android:type="linear" />
    <corners android:radius="24dp" />
</shape>
